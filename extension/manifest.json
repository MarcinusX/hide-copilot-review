{
  "manifest_version": 3,
  "name": "Hide Copilot Review",
  "version": "1.0.0",
  "description": "Hides the Copilot reviewer suggestion and \"Request\" button on GitHub pull requests.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "css": ["hide-copilot.css"],
      "run_at": "document_start"
    }
  ]
}
